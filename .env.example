# Secrets and local overrides for running commands on your own computer.
# Copy this file to `.env` and fill in the two secrets. `.env` is never committed.
#
# Everything else (your server, charity, branding...) lives in fly.toml, which these
# commands read too. Anything you set here overrides fly.toml on this computer only.
# Run `npm run check-config` to check everything.

# ---- Secrets (never share these) ------------------------------------------
# Discord Developer Portal > your app > Bot > Reset Token.
DISCORD_TOKEN=
# developer.justgiving.com > Applications > your app's App ID.
JUSTGIVING_APP_ID=

# ---- Only for running the bot on this computer (`npm run dev`) -------------
# Where JustGiving sends donors back to, and where the database file lives.
# Keep these as they are unless you know you need something else.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
DATABASE_PATH=./data/donors.db
