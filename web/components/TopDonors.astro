---
import type { TopDonor } from '../../src/web/api.js';
import { money } from '../format.js';

interface Props {
  donors: TopDonor[];
  locale: string;
}

const { donors, locale } = Astro.props;
const places = ['1st', '2nd', '3rd'];

---

<ol class="top">
  {
    donors.map((donor, index) => (
      <li class={`place place-${index + 1}`}>
        <span class="rank">{places[index]}</span>
        <img class="avatar" src={donor.avatarUrl} alt="" width="56" height="56" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        <span class="name">{donor.name}</span>
        <span class="total">{money(donor.total, donor.currencySymbol, locale)}</span>
        <span class="count muted">
          {donor.donations} donation{donor.donations === 1 ? '' : 's'}
        </span>
      </li>
    ))
  }
</ol>
<p class="note muted">Based on donations made through <code>/donate</code> with a public amount on JustGiving. Updates every few minutes.</p>

<style>
  .top {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }
  .place {
    --medal: #cd7f32;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 0;
    padding: 16px 12px;
    border-radius: var(--radius);
    background: var(--field);
    border-top: 3px solid var(--medal);
    text-align: center;
  }
  .place-1 {
    --medal: var(--gold);
  }
  .place-2 {
    --medal: #c9ced6;
  }
  .rank {
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--medal);
  }
  .avatar {
    width: 56px;
    height: 56px;
    margin: 6px 0;
    border-radius: 50%;
    background: var(--panel);
    box-shadow: 0 0 0 2px var(--field), 0 0 0 4px var(--medal);
  }
  .name {
    max-width: 100%;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .total {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .count {
    font-size: 0.8125rem;
  }
  .note {
    margin: 14px 0 0;
    font-size: 0.8125rem;
  }
</style>
