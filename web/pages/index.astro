---
import DiscordIcon from '../components/DiscordIcon.astro';
import DonorFeed from '../components/DonorFeed.astro';
import TopDonors from '../components/TopDonors.astro';
import { money } from '../format.js';
import Layout from '../layouts/Layout.astro';

const site = Astro.locals.web.getSite();
const home = await Astro.locals.web.getHome();
const { totals } = home;
const charity = site.charityName;

const percent = totals?.target ? Math.floor((totals.raised / totals.target) * 100) : null;
const barWidth = percent === null ? 0 : Math.min(100, Math.max(percent, totals && totals.raised > 0 ? 2 : 0));

const ended = home.endsAt !== null && Date.now() >= home.endsAt;
const daysLeft = home.endsAt !== null && !ended ? Math.ceil((home.endsAt - Date.now()) / 86_400_000) : null;
// endsAt is usually midnight at the start of the next day, so show the last day of the drive.
const endDate = home.endsAt
  ? new Date(home.endsAt - 1).toLocaleDateString(site.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: site.timeZone })
  : null;

Astro.response.headers.set('Cache-Control', 'public, max-age=30');
---

<Layout title={`${charity} charity drive · ${site.communityName}`} refreshSeconds={60}>
  <section class="hero">
    <p class="eyebrow">
      <span class="dot" aria-hidden="true"></span>
      {ended ? 'Charity drive · ended' : endDate ? `Charity drive · until ${endDate}` : 'Charity drive'}
    </p>
    <h1 class="display">{site.headline}</h1>
    <p class="lede">
      Donate <strong>any amount</strong> through our Discord and {site.rewardText}. Every penny goes straight to {charity}.
    </p>
    {
      !ended && site.inviteUrl && (
        <div class="actions">
          <a class="button" href={site.inviteUrl}>
            <DiscordIcon />
            Join and donate
          </a>
        </div>
      )
    }
  </section>

  <section class="card total" aria-labelledby="raised">
    <div class="label-row">
      <p class="label">Raised so far</p>
      {(ended || daysLeft !== null) && <span class="pin">{ended ? 'Drive ended' : `${daysLeft} day${daysLeft === 1 ? '' : 's'} left`}</span>}
    </div>
    {
      totals ? (
        <>
          <p class="amount display" id="raised">
            {money(totals.raised, totals.currencySymbol, site.locale)}
          </p>
          {totals.target && (
            <>
              <div
                class="bar"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow={String(Math.min(percent ?? 0, 100))}
                aria-label="Progress towards the target"
              >
                <span class="fill" style={`width: ${barWidth}%`} />
              </div>
              <p class="target muted">
                <strong>{percent}%</strong> of our {money(totals.target, totals.currencySymbol, site.locale)} target
              </p>
            </>
          )}
        </>
      ) : (
        <p class="amount display" id="raised">
          Open now
        </p>
      )
    }

    {
      !ended && (
        <p class="how muted">
          Join the Discord, run <code>/donate</code> and use your personal JustGiving link. Your role is added as soon as you've donated.
        </p>
      )
    }
  </section>

  {
    home.topDonors.length > 0 && (
      <section class="card" aria-labelledby="top">
        <div class="wall-head">
          <h2 id="top" class="display">Top donors</h2>
        </div>
        <TopDonors donors={home.topDonors} locale={site.locale} />
      </section>
    )
  }

  <section class="card" aria-labelledby="wall">
    <div class="wall-head">
      <h2 id="wall" class="display">Donor wall</h2>
      <span class="live"><span class="dot" aria-hidden="true"></span>Live</span>
    </div>
    <DonorFeed items={home.feed} charityName={charity} locale={site.locale} timeZone={site.timeZone} />
  </section>

  <footer class="footer muted">
    <p>Donations go straight to {charity} through JustGiving. We never see payment details. Only amounts donors made public on JustGiving appear in the top donors list.</p>
    <p>Rather not appear on the wall? Run <code>/donor-wall hide</code> in Discord.</p>
    <p>
      To manage your role, we store your Discord link, donation IDs, personal donation code (if used), wall setting and operational records.
      <code>/donor-forget</code> removes your user-linked records from the active bot but keeps used donation IDs, without your Discord link, to prevent reuse while donations remain redeemable.
      You keep the role, but recovery and refund tracking stop. Earlier backups expire separately; already served pages and messages may remain.
    </p>
    {site.festive && <p class="season">Merry Christmas from {site.communityName}</p>}
  </footer>
</Layout>

<style>
  .hero {
    margin-bottom: 40px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  h1 {
    margin: 0 0 16px;
    font-size: clamp(2.25rem, 7vw, 3.5rem);
  }
  h2 {
    margin: 0;
    font-size: 1.375rem;
  }
  .lede {
    max-width: 560px;
    margin: 0 0 24px;
  }

  .label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }
  .label {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .pin {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--field);
    color: var(--muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .amount {
    margin: 0;
    font-size: clamp(2.75rem, 10vw, 4rem);
    color: var(--accent-text);
  }
  .bar {
    height: 12px;
    margin: 18px 0 10px;
    border-radius: 999px;
    background: var(--field);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), var(--accent-text));
  }
  .target {
    margin: 0;
    font-size: 0.9375rem;
  }
  .target strong {
    color: var(--text);
  }
  .how {
    margin: 18px 0 0;
    font-size: 0.875rem;
  }

  .wall-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgb(34 197 94 / 0.12);
    color: var(--green);
    font-size: 0.8125rem;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }

  .footer {
    margin-top: 32px;
    font-size: 0.8125rem;
  }
  .footer p {
    margin: 4px 0;
  }
  .footer .season {
    margin-top: 12px;
    color: var(--gold);
    font-weight: 700;
  }
</style>
